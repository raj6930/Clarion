# ═══════════════════════════════════════════════════════
# Clarion — Environment Configuration
# Copy to .env and fill in values
# ═══════════════════════════════════════════════════════

# ─── Database ───
CLARION_DB_HOST=clarion-db
CLARION_DB_PORT=5432
CLARION_DB_NAME=clarion
CLARION_DB_USER=clarion
CLARION_DB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# ─── Redis ───
CLARION_REDIS_URL=redis://clarion-redis:6379/0

# ─── JWT ───
CLARION_JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_KEY
CLARION_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
CLARION_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Encryption ───
CLARION_MASTER_KEY_REF=clarion-master

# ─── Ollama ───
CLARION_OLLAMA_URL=http://clarion-ollama:11434
CLARION_DEFAULT_LOCAL_MODEL=gemma2

# ─── External AI (optional — configure via Admin UI) ───
# CLARION_CLAUDE_API_KEY=
# CLARION_OPENAI_API_KEY=

# ─── Application ───
CLARION_LOG_LEVEL=INFO
CLARION_CORS_ORIGINS=https://localhost
CLARION_FRONTEND_URL=https://localhost
CLARION_ENVIRONMENT=development

# ─── Email (configure via Admin UI or here) ───
# CLARION_SMTP_HOST=
# CLARION_SMTP_PORT=587
# CLARION_SMTP_USER=
# CLARION_SMTP_PASSWORD=
# CLARION_SMTP_FROM=
