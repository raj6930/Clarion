# ═══════════════════════════════════════════════════════
# Clarion — Local Development Environment
# ═══════════════════════════════════════════════════════

# ─── Database ───
CLARION_DB_HOST=clarion-db
CLARION_DB_PORT=5432
CLARION_DB_NAME=clarion
CLARION_DB_USER=clarion
CLARION_DB_PASSWORD=clarion_dev_2026

# ─── Redis ───
CLARION_REDIS_URL=redis://clarion-redis:6379/0

# ─── JWT ───
CLARION_JWT_SECRET=dev-jwt-secret-change-in-production-abc123xyz
CLARION_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
CLARION_JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Encryption ───
CLARION_MASTER_KEY_REF=clarion-master

# ─── Ollama (not started by default — add later) ───
CLARION_OLLAMA_URL=http://clarion-ollama:11434
CLARION_DEFAULT_LOCAL_MODEL=gemma2

# ─── External AI (optional) ───
# CLARION_CLAUDE_API_KEY=
# CLARION_OPENAI_API_KEY=

# ─── Application ───
CLARION_LOG_LEVEL=INFO
CLARION_CORS_ORIGINS=https://localhost,http://localhost,http://localhost:3000
CLARION_FRONTEND_URL=https://localhost
CLARION_ENVIRONMENT=development
